{
  "id": "S6-critical-release",
  "title": "Critical release: plan, two approvers, simulated publication",
  "description": "Publishing a release is CRITICAL. The control plane generates a release plan bound to the current evidence, requires two distinct approvers including a release manager, and runs the publication only as a simulation. Nothing is deployed.",
  "request": {
    "title": "Release Lumen Notes 1.4.0",
    "project": "lumen-notes",
    "requester": "riley.chen",
    "release": {"version": "1.4.0", "notes": "Tag search documentation and case-insensitive search."},
    "steps": [
      {"action": "prepare_release"},
      {"action": "publish_release"}
    ]
  },
  "steps": [
    {"do": "submit"},
    {"do": "classify", "state": "CLASSIFIED", "note": "publish_release is CRITICAL"},
    {"do": "evidence", "type": "plan"},
    {"do": "plan", "state": "PLANNED"},
    {"do": "evidence", "type": "test_report", "source": "ci-simulator"},
    {"do": "evidence", "type": "risk_assessment"},
    {"do": "review", "state": "EVIDENCE_PENDING", "note": "release plan not generated yet"},
    {"do": "release_plan", "state": "EVIDENCE_PENDING", "note": "generated by the control plane from current evidence"},
    {"do": "review", "state": "READY_FOR_REVIEW"},
    {"do": "authorize", "state": "APPROVAL_REQUIRED"},
    {"do": "approve", "actor": "sam.ortiz", "state": "APPROVAL_REQUIRED", "note": "1 of 2; a release manager is still needed"},
    {"do": "approve", "actor": "sam.ortiz", "expect": "APPROVAL_REJECTED", "state": "APPROVAL_REQUIRED", "note": "same approver twice"},
    {"do": "approve", "actor": "kai.morgan", "state": "AUTHORIZED", "note": "release manager completes the quorum"},
    {"do": "execute", "actor": "agent.worker", "state": "VERIFIED", "note": "simulated publication in the sandbox"},
    {"do": "complete", "state": "COMPLETED"}
  ]
}
