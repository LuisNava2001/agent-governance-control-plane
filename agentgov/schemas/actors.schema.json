{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentgov/actors",
  "title": "Local actor directory (demo; not an identity provider)",
  "type": "object",
  "additionalProperties": false,
  "required": ["actors"],
  "properties": {
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "roles"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]+\\.[a-z]+$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 80},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["engineer", "approver", "release_manager", "agent"]}
          }
        }
      }
    }
  }
}
