{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentgov/evidence_release_plan",
  "title": "Release plan (generated by the control plane)",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "subject_fingerprint", "release_id", "version", "changes", "evidence", "rollback", "deployment"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^TASK-\\d{4}$"},
    "subject_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release_id": {"type": "string", "pattern": "^RP-\\d{4}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {"action": {"type": "string"}, "path": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "type", "digest"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EV-\\d{4}$"},
          "type": {"type": "string"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "rollback": {"type": "string", "minLength": 5},
    "deployment": {"const": "NOT_PERFORMED"}
  }
}
